{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/bun.lock",
      "!**/.claude",
      "!**/*.md",
      "!**/*.yml"
    ]
  }
}
