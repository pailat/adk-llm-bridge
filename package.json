{
  "name": "adk-llm-bridge",
  "version": "0.7.0",
  "description": "Use OpenAI, Anthropic, xAI, OpenRouter and AI Gateway models (100+), external coding agents (Claude Code, Codex, fx) and durable workflows with Google ADK for TypeScript",
  "keywords": [
    "adk",
    "google-adk",
    "ai-gateway",
    "openrouter",
    "vercel",
    "llm",
    "agents",
    "multi-provider",
    "anthropic",
    "openai",
    "xai",
    "claude",
    "codex",
    "gemini",
    "workflows"
  ],
  "license": "MIT",
  "author": "adk-llm-bridge contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pailat/adk-llm-bridge.git"
  },
  "homepage": "https://github.com/pailat/adk-llm-bridge#readme",
  "bugs": {
    "url": "https://github.com/pailat/adk-llm-bridge/issues"
  },
  "workspaces": [
    "examples/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./agents/session-store/sqlite": {
      "types": "./dist/agents/session-store/sqlite/index.d.ts",
      "import": "./dist/agents/session-store/sqlite/index.js"
    },
    "./agents/session-store/adk-artifacts": {
      "types": "./dist/agents/session-store/adk-artifacts/index.d.ts",
      "import": "./dist/agents/session-store/adk-artifacts/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "import": "./dist/workflows/index.js"
    },
    "./workflows/node": {
      "types": "./dist/workflows/node/index.d.ts",
      "import": "./dist/workflows/node/index.js"
    },
    "./workflows/checkpoint/sqlite": {
      "types": "./dist/workflows/checkpoint/sqlite/index.d.ts",
      "import": "./dist/workflows/checkpoint/sqlite/index.js"
    },
    "./workflows/events/sqlite": {
      "types": "./dist/workflows/events/sqlite/index.d.ts",
      "import": "./dist/workflows/events/sqlite/index.js"
    },
    "./workflows/storage/conformance": {
      "types": "./dist/workflows/storage/conformance/index.d.ts",
      "import": "./dist/workflows/storage/conformance/index.js"
    },
    "./workflows/spec": {
      "types": "./dist/workflows/spec/index.d.ts",
      "import": "./dist/workflows/spec/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "bunup && bun scripts/fix-dts-private.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:all": "bunx tsc --noEmit -p tsconfig.test.json",
    "typecheck:conformance": "bunx tsc --noEmit --ignoreConfig --skipLibCheck --target ESNext --module NodeNext --moduleResolution NodeNext --esModuleInterop --types bun scripts/conformance/run-runtime.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:comments": "bun scripts/check-comments.ts",
    "check:links": "bun scripts/check-links.ts",
    "check:export-docs": "bun scripts/check-export-docs.ts",
    "check:dist": "bun scripts/check-export-docs.ts && bun scripts/fix-dts-private.ts --check && bun scripts/check-dts-extensions.ts && bun scripts/check-dist-permissions.ts && bun scripts/check-dist-entries.ts && bun scripts/check-dist-notices.ts",
    "check:fix": "biome check --write .",
    "lint:publish": "publint --strict && attw --pack --profile esm-only",
    "ci": "bun run typecheck:all && bun run typecheck:conformance && bun run check && bun run check:comments && bun run check:links && bun test && bun run build && bun run check:dist && bun run check:compat:nodenext && bun run lint:publish",
    "prepublishOnly": "bun run check:comments && bun run build && bun run check:dist && bun run lint:publish",
    "check:compat:nodenext": "bunx tsc -p tests/compat/nodenext-consumer/tsconfig.json",
    "typecheck:compat:nodenext": "bun run build && bun run check:compat:nodenext"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.319 <0.4",
    "@google/adk": ">=2.4.0 <3",
    "@google/genai": ">=2.29.1 <3",
    "@jitl/quickjs-wasmfile-release-sync": ">=0.32.0 <0.33.0",
    "@openai/codex-sdk": "0.167.2",
    "@opentelemetry/api": ">=1.9.1 <2",
    "quickjs-emscripten-core": ">=0.32.0 <0.33.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    },
    "@jitl/quickjs-wasmfile-release-sync": {
      "optional": true
    },
    "quickjs-emscripten-core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "openai": "^7.53.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.6",
    "@google/adk": "^2.4.0",
    "@google/genai": "^2.32.0",
    "@jitl/quickjs-wasmfile-debug-sync": "^0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@microsoft/tsdoc": "0.17.1",
    "@mikro-orm/sqlite": "^7.2.5",
    "@openai/codex-sdk": "0.167.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/bun": "^1.4.4",
    "bunup": "^0.16.32",
    "publint": "^0.3.25",
    "quickjs-emscripten-core": "^0.32.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6",
    "rimraf": "^6.1.4",
    "uuid": "^11.1.1"
  }
}
