{
  "name": "adk-llm-bridge",
  "version": "0.7.0",
  "description": "Use any LLM with Google ADK TypeScript - supports AI Gateway, OpenRouter, and 100+ models",
  "keywords": [
    "adk",
    "google-adk",
    "ai-gateway",
    "openrouter",
    "vercel",
    "llm",
    "agents",
    "multi-provider"
  ],
  "license": "MIT",
  "author": "PAI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pailat/adk-llm-bridge.git"
  },
  "homepage": "https://github.com/pailat/adk-llm-bridge#readme",
  "bugs": {
    "url": "https://github.com/pailat/adk-llm-bridge/issues"
  },
  "workspaces": [
    "examples/*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "import": "./dist/workflows/index.js"
    },
    "./workflows/node": {
      "types": "./dist/workflows/node/index.d.ts",
      "import": "./dist/workflows/node/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "bunup && bun scripts/fix-dts-private.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:all": "bunx tsc --noEmit -p tsconfig.test.json",
    "typecheck:conformance": "bunx tsc --noEmit --ignoreConfig --skipLibCheck --target ESNext --module NodeNext --moduleResolution NodeNext --esModuleInterop --types bun scripts/conformance/run-runtime.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint:publish": "publint --strict && attw --pack --profile esm-only",
    "ci": "bun run typecheck:all && bun run typecheck:conformance && bun run check && bun test && bun run build && bun scripts/fix-dts-private.ts --check && bun scripts/check-dist-permissions.ts && bun run lint:publish",
    "prepublishOnly": "bun run build && bun scripts/fix-dts-private.ts --check && bun scripts/check-dist-permissions.ts && bun run lint:publish",
    "typecheck:compat:nodenext": "bun run build && bunx tsc -p tests/compat/nodenext-consumer/tsconfig.json"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.319 <0.4",
    "@google/adk": ">=2.4.0 <3",
    "@google/genai": ">=2.29.1 <3",
    "@jitl/quickjs-wasmfile-release-sync": ">=0.32.0 <0.33.0",
    "@openai/codex-sdk": ">=0.167.0 <0.168",
    "@opentelemetry/api": ">=1.9.1 <2",
    "quickjs-emscripten-core": ">=0.32.0 <0.33.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    },
    "@jitl/quickjs-wasmfile-release-sync": {
      "optional": true
    },
    "quickjs-emscripten-core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "openai": "^7.53.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.6",
    "@google/adk": "^2.4.0",
    "@google/genai": "^2.32.0",
    "@openai/codex-sdk": "^0.167.0",
    "@jitl/quickjs-wasmfile-debug-sync": "^0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@opentelemetry/api": "^1.10.0",
    "@types/bun": "^1.4.4",
    "bunup": "^0.16.32",
    "publint": "^0.3.25",
    "quickjs-emscripten-core": "^0.32.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6",
    "rimraf": "^6.1.4",
    "uuid": "^11.1.1"
  }
}
