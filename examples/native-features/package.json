{
  "name": "native-features-example",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun run --watch src/cli.ts",
    "list": "bun run src/cli.ts list",
    "all": "bun run src/cli.ts all",
    "sampling": "bun run src/cli.ts sampling",
    "reasoning": "bun run src/cli.ts reasoning",
    "structured": "bun run src/cli.ts structured-output",
    "multimodal": "bun run src/cli.ts multimodal",
    "tool-choice": "bun run src/cli.ts tool-choice",
    "streaming": "bun run src/cli.ts streaming",
    "web": "bunx @google/adk-devtools web",
    "web:dev": "bunx @google/adk-devtools run agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/adk": "^2.5.0",
    "@google/genai": "^2.32.0",
    "@opentelemetry/api": "^1.10.0",
    "adk-llm-bridge": "^0.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
