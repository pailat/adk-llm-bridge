{
  "description": "Two allowed paths are invalid: one contains a NUL character, and one of exactly 4,096 characters becomes longer than the portable path limit once joined to the non-root projectRoot.",
  "rules": null,
  "spec": {
    "specVersion": 1,
    "workflowId": "lanes",
    "workflowVersion": "1",
    "projectRoot": "pkg",
    "budget": {
      "maxUsd": 5
    },
    "maxConcurrency": 2,
    "lanes": [
      {
        "taskId": "api",
        "title": "Add the health endpoint",
        "role": "worker",
        "dependsOn": [],
        "allowedPaths": ["src/\u0000api"],
        "agent": {
          "providerId": "claude-code",
          "model": "claude-sonnet-5",
          "mode": "workspace-write",
          "tools": ["Read", "Edit"]
        },
        "steps": {
          "testsFirst": true,
          "review": {
            "kind": "agent",
            "providerId": "codex",
            "model": "gpt-5.5",
            "maxChangeRounds": 2
          }
        }
      },
      {
        "taskId": "docs",
        "title": "Document the health endpoint",
        "role": "worker",
        "dependsOn": ["api"],
        "allowedPaths": [
          ""
        ],
        "agent": {
          "providerId": "codex",
          "model": "gpt-5.5",
          "mode": "workspace-write",
          "allowNetwork": false,
          "tools": []
        },
        "steps": {
          "testsFirst": false,
          "review": {
            "kind": "none"
          }
        }
      }
    ],
    "gates": {
      "qa": [
        {
          "id": "test",
          "command": ["bun", "run", "test"]
        }
      ],
      "publish": {
        "kind": "commit",
        "hitl": true
      }
    },
    "env": ["CI"]
  },
  "expectCodes": ["RUN_SPEC_PATH_INVALID"]
}
