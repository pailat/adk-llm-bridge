{
  "description": "The spec names version 2, which this library does not support.",
  "rules": null,
  "spec": {
    "specVersion": 2,
    "workflowId": "lanes",
    "workflowVersion": "1",
    "projectRoot": ".",
    "budget": {
      "maxUsd": 5
    },
    "maxConcurrency": 2,
    "lanes": [
      {
        "taskId": "api",
        "title": "Add the health endpoint",
        "role": "worker",
        "dependsOn": [],
        "allowedPaths": ["src/api", "tests/api"],
        "agent": {
          "providerId": "claude-code",
          "model": "claude-sonnet-5",
          "mode": "workspace-write",
          "tools": ["Read", "Edit"]
        },
        "steps": {
          "testsFirst": true,
          "review": {
            "kind": "agent",
            "providerId": "codex",
            "model": "gpt-5.5",
            "maxChangeRounds": 2
          }
        }
      },
      {
        "taskId": "docs",
        "title": "Document the health endpoint",
        "role": "worker",
        "dependsOn": ["api"],
        "allowedPaths": ["docs/api.md"],
        "agent": {
          "providerId": "codex",
          "model": "gpt-5.5",
          "mode": "workspace-write",
          "allowNetwork": false,
          "tools": []
        },
        "steps": {
          "testsFirst": false,
          "review": {
            "kind": "none"
          }
        }
      }
    ],
    "gates": {
      "qa": [
        {
          "id": "test",
          "command": ["bun", "run", "test"]
        }
      ],
      "publish": {
        "kind": "commit",
        "hitl": true
      }
    },
    "env": ["CI"]
  },
  "expectCodes": ["RUN_SPEC_VERSION_UNSUPPORTED"]
}
