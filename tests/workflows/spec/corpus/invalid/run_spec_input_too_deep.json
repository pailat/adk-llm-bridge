{
  "description": "Extension data is nested 20 levels deep, over the input depth of 16.",
  "rules": null,
  "spec": {
    "specVersion": 1,
    "workflowId": "lanes",
    "workflowVersion": "1",
    "projectRoot": ".",
    "budget": {
      "maxUsd": 5
    },
    "maxConcurrency": 2,
    "lanes": [
      {
        "taskId": "api",
        "title": "Add the health endpoint",
        "role": "worker",
        "dependsOn": [],
        "allowedPaths": ["src/api", "tests/api"],
        "agent": {
          "providerId": "claude-code",
          "model": "claude-sonnet-5",
          "mode": "workspace-write",
          "tools": ["Read", "Edit"]
        },
        "steps": {
          "testsFirst": true,
          "review": {
            "kind": "agent",
            "providerId": "codex",
            "model": "gpt-5.5",
            "maxChangeRounds": 2
          }
        }
      },
      {
        "taskId": "docs",
        "title": "Document the health endpoint",
        "role": "worker",
        "dependsOn": ["api"],
        "allowedPaths": ["docs/api.md"],
        "agent": {
          "providerId": "codex",
          "model": "gpt-5.5",
          "mode": "workspace-write",
          "allowNetwork": false,
          "tools": []
        },
        "steps": {
          "testsFirst": false,
          "review": {
            "kind": "none"
          }
        }
      }
    ],
    "gates": {
      "qa": [
        {
          "id": "test",
          "command": ["bun", "run", "test"]
        }
      ],
      "publish": {
        "kind": "commit",
        "hitl": true
      }
    },
    "env": ["CI"],
    "extensions": {
      "x-deep": {
        "n": {
          "n": {
            "n": {
              "n": {
                "n": {
                  "n": {
                    "n": {
                      "n": {
                        "n": {
                          "n": {
                            "n": {
                              "n": {
                                "n": {
                                  "n": {
                                    "n": {
                                      "n": {
                                        "n": {
                                          "n": {
                                            "n": {
                                              "n": "leaf"
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "expectCodes": ["RUN_SPEC_INPUT_TOO_DEEP"]
}
