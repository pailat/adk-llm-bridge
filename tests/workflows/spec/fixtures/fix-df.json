            "Grep",
            "NotebookEdit",
            "Read",
            "Write"
          ]
        },
        "steps": {
          "testsFirst": true,
          "review": {
            "kind": "agent",
            "providerId": "claude",
            "model": "claude-opus-5-5",
            "maxChangeRounds": 2
          }
        }
      },
      {
        "taskId": "resumed-session-cost",
