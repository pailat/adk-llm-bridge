          "docs/external-agent-isolation.md"
        ],
        "agent": {
          "providerId": "claude",
          "model": "claude-sonnet-5-5",
          "mode": "workspace-write",
          "tools": [
            "Bash",
            "Edit",
            "Glob",
            "Grep",
            "NotebookEdit",
            "Read",
            "Write"
          ]
        },
        "steps": {
          "testsFirst": true,
          "review": {
            "kind": "agent",
            "providerId": "claude",
            "model": "claude-opus-5-5",
            "maxChangeRounds": 2
          }
        }
      }
    ],
    "gates": {
      "qa": [
        {
          "id": "ci",
          "command": ["bun", "run", "ci"]
        }
      ],
      "publish": {
        "kind": "none"
      }
    },
    "env": []
  }
}
