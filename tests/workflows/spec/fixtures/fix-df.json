        "role": "worker",
        "dependsOn": [],
        "allowedPaths": [
          "src/agents/driver/claude-agent-sdk.ts",
          "src/agents/driver/run-summary.ts",
          "src/agents/driver/claude-cli.ts",
          "src/agents/events.ts",
          "src/agents/telemetry.ts",
          "tests/agents/driver",
          "README.md"
        ],
        "agent": {
          "providerId": "claude",
          "model": "claude-sonnet-5-5",
          "mode": "workspace-write",
          "tools": [
            "Bash",
            "Edit",
            "Glob",
            "Grep",
            "NotebookEdit",
            "Read",
            "Write"
          ]
        },
        "steps": {
          "testsFirst": true,
          "review": {
            "kind": "agent",
            "providerId": "claude",
            "model": "claude-opus-5-5",
            "maxChangeRounds": 2
          }
        }
      },
      {
        "taskId": "tool-isolation",
        "title": "Stop reporting an offered tool as an isolation violation",
        "role": "worker",
        "dependsOn": [],
        "allowedPaths": [
          "src/agents/driver/claude-isolation.ts",
